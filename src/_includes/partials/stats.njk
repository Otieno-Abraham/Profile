<section class="container" aria-label="Headline metrics">
  <dl class="stats">
    {% for m in site.metrics %}
      <div>
        <dt class="stat-label">{{ m.label }}</dt>
        <dd class="stat-value">{{ m.value }}</dd>
        {% if m.detail %}<dd class="stat-detail">{{ m.detail }}</dd>{% endif %}
      </div>
    {% endfor %}
  </dl>
</section>
